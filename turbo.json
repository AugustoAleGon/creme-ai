{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".env", ".oxlintrc.json", "tsconfig.base.json"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["DATABASE_URL", "API_PORT", "WEB_PORT"]
    },
    "lint": {},
    "typecheck": { "dependsOn": ["^build"] },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["TEST_DATABASE_URL"]
    }
  }
}
